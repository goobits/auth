{
	"name": "pdx-run",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.11.1",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm --filter @goobits/auth build && vite build",
		"preview": "vite preview",
		"cf:dev": "pnpm build && NODE_ENV=production wrangler pages dev .svelte-kit/cloudflare --ip 0.0.0.0 --port 3580",
		"cf:deploy": "pnpm build && wrangler pages deploy .svelte-kit/cloudflare",
		"cf:check": "./scripts/predeploy-check.sh",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run --coverage",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test": "pnpm test:unit",
		"test:all": "pnpm test:unit && pnpm test:e2e",
		"validate": "pnpm lint && pnpm check && pnpm build"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@vitest/coverage-v8": "^3.2.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.7",
		"@sveltejs/kit": "^2.52.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.2.3",
		"eslint": "^10.0.0",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"sass": "^1.97.3",
		"svelte": "^5.51.2",
		"svelte-check": "^4.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0",
		"vite": "^7.3.1",
		"vitest": "^3.2.4",
		"wrangler": "^4.65.0"
	},
	"dependencies": {
		"@goobits/auth": "workspace:*",
		"lucide-svelte": "^0.564.0"
	}
}
