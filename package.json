{
	"name": "miko-art",
	"version": "1.0.27",
	"private": true,
	"scripts": {
		"build": "yarn version:patch && NODE_ENV=production vite build",
		"dev": "NODE_ENV=development vite dev --port 3000",
		"preview": "vite preview --port 3000",
		"start": "NODE_ENV=production DOTENV_CONFIG_PATH=./config/env/.env node -r dotenv/config build",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/enhanced-img": "^0.4.1",
		"@sveltejs/kit": "^2.9.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.1",
		"mdsvex": "^0.12.3",
		"prettier": "^3.4.1",
		"prettier-plugin-svelte": "^3.3.2",
		"sass-embedded": "^1.82.0",
		"stylus": "^0.64.0",
		"svelte": "^5.5.3"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.705.0",
		"@aws-sdk/client-ses": "^3.699.0",
		"@aws-sdk/s3-request-presigner": "^3.705.0",
		"dotenv": "^16.4.7",
		"formsnap": "^1.0.1",
		"rehype-slug": "^6.0.0",
		"remark-toc": "^9.0.0",
		"svelte-forms": "^2.3.1",
		"sveltekit-superforms": "^2.21.0",
		"vite": "^6.0.2",
		"zod": "^3.23.8"
	},
	"type": "module",
	"packageManager": "yarn@4.5.2"
}
