{
	"name": "miko-art",
	"version": "1.1.14",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "NODE_ENV=production dotenvx run -f config/env/.env -- vite build",
		"build:versioned": "pnpm run version:patch && pnpm run build",
		"dev": "dotenvx run -f config/env/.env -- bash tasks/dev-server.sh start",
		"dev:wrangler": "NODE_OPTIONS='--dns-result-order=ipv4first' dotenvx run -f config/env/.env -- wrangler dev --local",
		"stop": "bash tasks/dev-server.sh stop",
		"restart": "dotenvx run -f config/env/.env -- bash tasks/dev-server.sh restart",
		"preview": "vite preview --port 3000",
		"typecheck": "pnpm exec tsc --noEmit",
		"svelte:check": "pnpm exec svelte-check --tsconfig ./tsconfig.json",
		"lint": "pnpm exec eslint --no-error-on-unmatched-pattern src functions packages repos serverless scripts *.config.js *.config.ts",
		"circular": "pnpm exec madge --circular --extensions ts,js,svelte src functions packages repos serverless",
		"check:all": "pnpm run typecheck && pnpm run svelte:check && pnpm run lint && pnpm run circular",
		"e2e:sitemap": "node e2e/sitemap-smoke.mjs",
		"e2e:visual": "node e2e/visual-snapshots.mjs",
		"e2e:auth": "node e2e/auth-register-smoke.mjs",
		"start": "dotenvx run -f config/env/.env -- bash tasks/dev-server.sh start",
		"start:prod": "NODE_ENV=production dotenvx run -f config/env/.env -- node build",
		"deploy:secrets": "dotenvx run -f config/env/.env.production -- node scripts/deploy-secrets.mjs",
		"deploy:prod": "node scripts/deploy-prod.mjs",
		"deploy:prod:full": "node scripts/deploy-prod.mjs --full",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.52.0",
		"@eslint/js": "^9.39.2",
		"@node-rs/argon2": "^2.0.2",
		"@node-rs/bcrypt": "^1.10.7",
		"@sveltejs/adapter-cloudflare": "^7.2.7",
		"@sveltejs/enhanced-img": "^0.9.3",
		"@sveltejs/kit": "^2.51.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.2.3",
		"better-sqlite3": "^12.6.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"madge": "^8.0.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"sass-embedded": "^1.97.3",
		"stylus": "^0.64.0",
		"svelte": "^5.51.1",
		"svelte-check": "^4.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.55.0",
		"wrangler": "^4.65.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.990.0",
		"@aws-sdk/client-ses": "^3.990.0",
		"@aws-sdk/s3-request-presigner": "^3.990.0",
		"@goobits/auth": "file:./repos/auth",
		"@goobits/themes": "^1.3.2",
		"@lucide/svelte": "^0.564.0",
		"argon2-wasm-edge": "^1.0.23",
		"bcryptjs": "^3.0.2",
		"dotenv": "^17.3.1",
		"formsnap": "^2.0.1",
		"rehype-slug": "^6.0.0",
		"remark-toc": "^9.0.0",
		"svelte-forms": "^2.3.1",
		"sveltekit-superforms": "^2.29.1",
		"vite": "^7.3.1",
		"zod": "^4.3.6"
	},
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"better-sqlite3",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
