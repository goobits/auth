{
	"name": "miko-art",
	"version": "1.0.49",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "pnpm run version:patch && NODE_ENV=production vite build",
		"dev": "bash tasks/dev-server.sh start",
		"stop": "bash tasks/dev-server.sh stop",
		"restart": "bash tasks/dev-server.sh restart",
		"preview": "vite preview --port 3000",
		"start": "NODE_ENV=production DOTENV_CONFIG_PATH=./config/env/.env node -r dotenv/config build",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/enhanced-img": "^0.4.1",
		"@sveltejs/kit": "^2.9.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.1",
		"mdsvex": "^0.12.3",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"sass-embedded": "^1.82.0",
		"stylus": "^0.64.0",
		"svelte": "^5.7.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.705.0",
		"@aws-sdk/client-ses": "^3.699.0",
		"@aws-sdk/s3-request-presigner": "^3.705.0",
		"@goobits/themes": "^1.3.2",
		"@lucide/svelte": "^0.563.1",
		"better-sqlite3": "^11.10.0",
		"dotenv": "^16.4.7",
		"formsnap": "^1.0.1",
		"rehype-slug": "^6.0.0",
		"remark-toc": "^9.0.0",
		"svelte-forms": "^2.3.1",
		"sveltekit-superforms": "^2.21.1",
		"vite": "^6.0.3",
		"zod": "^3.23.8"
	},
	"type": "module",
	"packageManager": "pnpm@9.12.2"
}
