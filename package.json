{
  "name": "@goobits/auth",
  "version": "0.1.2",
  "description": "Pluggable authentication system for SvelteKit applications",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./adapters/database": "./src/adapters/database/index.ts",
    "./adapters/session": "./src/adapters/session/index.ts",
    "./adapters/oauth-token": "./src/adapters/oauth-token/index.ts",
    "./adapters/verification-token": "./src/adapters/verification-token/index.ts",
    "./adapters/magic-link": "./src/adapters/magic-link/index.ts",
    "./adapters/webauthn": "./src/adapters/webauthn/index.ts",
    "./providers": "./src/providers/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./utils": "./src/utils/index.ts",
    "./client": "./src/client/index.ts",
    "./types": "./src/types/index.ts",
    "./mfa": "./src/mfa/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/theme.css": "./src/ui/theme.css",
    "./security": "./src/security/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --testPathPattern=integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api:scan": "npx @goobits/codeatlas . --format json --out .codeatlas --suggest --entrypoints src/index.ts,src/adapters/index.ts,src/adapters/database/index.ts,src/adapters/session/index.ts,src/adapters/oauth-token/index.ts,src/adapters/verification-token/index.ts,src/adapters/magic-link/index.ts,src/adapters/webauthn/index.ts,src/providers/index.ts,src/handlers/index.ts,src/utils/index.ts,src/types/index.ts,src/mfa/index.ts,src/ui/index.ts,src/security/index.ts",
    "api:map": "npx @goobits/codeatlas . --format mermaid --out .codeatlas --entrypoints src/index.ts,src/adapters/index.ts,src/adapters/database/index.ts,src/adapters/session/index.ts,src/adapters/oauth-token/index.ts,src/adapters/verification-token/index.ts,src/adapters/magic-link/index.ts,src/adapters/webauthn/index.ts,src/providers/index.ts,src/handlers/index.ts,src/utils/index.ts,src/types/index.ts,src/mfa/index.ts,src/ui/index.ts,src/security/index.ts"
  },
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "sveltekit",
    "session",
    "drizzle"
  ],
  "author": "@goobits",
  "license": "MIT",
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "drizzle-orm": "^0.44.0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@simplewebauthn/server": "^13.0.0",
    "arctic": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "pg": "^8.18.0",
    "pg-mem": "^3.0.8",
    "pg-server": "^0.1.8",
    "postgres": "^3.4.8",
    "typescript": "^5.8.2",
    "vitest": "^4.0.6"
  },
  "vitest": {
    "test": {
      "setupFiles": [
        "./vitest.setup.js"
      ]
    }
  }
}
