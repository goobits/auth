{
	"name": "miko-art",
	"version": "1.0.82",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "pnpm run version:patch && NODE_ENV=production vite build",
		"dev": "bash tasks/dev-server.sh start",
		"stop": "bash tasks/dev-server.sh stop",
		"restart": "bash tasks/dev-server.sh restart",
		"preview": "vite preview --port 3000",
		"start": "NODE_ENV=production DOTENV_CONFIG_PATH=./config/env/.env node -r dotenv/config build",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version"
	},
	"devDependencies": {
		"@node-rs/argon2": "^2.0.2",
		"@node-rs/bcrypt": "^1.10.7",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/enhanced-img": "^0.9.3",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.2.0",
		"better-sqlite3": "^12.6.2",
		"mdsvex": "^0.12.6",
		"playwright": "^1.58.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"sass-embedded": "^1.97.3",
		"stylus": "^0.64.0",
		"svelte": "^5.49.1",
		"typescript": "^5.9.3",
		"wrangler": "^4.61.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.981.0",
		"@aws-sdk/client-ses": "^3.981.0",
		"@aws-sdk/s3-request-presigner": "^3.981.0",
		"@goobits/auth": "file:./repos/auth",
		"@goobits/themes": "^1.3.2",
		"@lucide/svelte": "^0.563.1",
		"dotenv": "^17.2.3",
		"formsnap": "^2.0.1",
		"rehype-slug": "^6.0.0",
		"remark-toc": "^9.0.0",
		"svelte-forms": "^2.3.1",
		"sveltekit-superforms": "^2.29.1",
		"vite": "^7.3.1",
		"zod": "^4.3.6"
	},
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"better-sqlite3",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
