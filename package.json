{
  "name": "@goobits/auth",
  "version": "0.2.0",
  "description": "Pluggable authentication system for SvelteKit applications",
  "type": "module",
  "main": "./dist/node/index.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "": [
        "./dist/types/index.d.ts"
      ],
      "adapters": [
        "./dist/types/adapters/index.d.ts"
      ],
      "adapters/database": [
        "./dist/types/adapters/database/index.d.ts"
      ],
      "adapters/session": [
        "./dist/types/adapters/session/index.d.ts"
      ],
      "adapters/oauth-token": [
        "./dist/types/adapters/oauth-token/index.d.ts"
      ],
      "adapters/drizzle": [
        "./dist/types/adapters/drizzle/index.d.ts"
      ],
      "adapters/verification-token": [
        "./dist/types/adapters/verification-token/index.d.ts"
      ],
      "adapters/magic-link": [
        "./dist/types/adapters/magic-link/index.d.ts"
      ],
      "adapters/webauthn": [
        "./dist/types/adapters/webauthn/index.d.ts"
      ],
      "providers": [
        "./dist/types/providers/index.d.ts"
      ],
      "handlers": [
        "./dist/types/handlers/index.d.ts"
      ],
      "utils": [
        "./dist/types/utils/index.d.ts"
      ],
      "client": [
        "./dist/types/client/index.d.ts"
      ],
      "types": [
        "./dist/types/types/index.d.ts"
      ],
      "testing": [
        "./dist/types/testing/index.d.ts"
      ],
      "mfa": [
        "./dist/types/mfa/index.d.ts"
      ],
      "ui": [
        "./dist/types/ui/index.d.ts"
      ],
      "security": [
        "./dist/types/security/index.d.ts"
      ],
      "errors": [
        "./dist/types/errors/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": "./dist/node/index.js",
      "default": "./dist/worker/index.js"
    },
    "./adapters": {
      "types": "./dist/types/adapters/index.d.ts",
      "node": "./dist/node/adapters/index.js",
      "default": "./dist/worker/adapters/index.js"
    },
    "./adapters/database": {
      "types": "./dist/types/adapters/database/index.d.ts",
      "node": "./dist/node/adapters/database/index.js",
      "default": "./dist/worker/adapters/database/index.js"
    },
    "./adapters/session": {
      "types": "./dist/types/adapters/session/index.d.ts",
      "node": "./dist/node/adapters/session/index.js",
      "default": "./dist/worker/adapters/session/index.js"
    },
    "./adapters/oauth-token": {
      "types": "./dist/types/adapters/oauth-token/index.d.ts",
      "node": "./dist/node/adapters/oauth-token/index.js",
      "default": "./dist/worker/adapters/oauth-token/index.js"
    },
    "./adapters/drizzle": {
      "types": "./dist/types/adapters/drizzle/index.d.ts",
      "node": "./dist/node/adapters/drizzle/index.js",
      "default": "./dist/worker/adapters/drizzle/index.js"
    },
    "./adapters/verification-token": {
      "types": "./dist/types/adapters/verification-token/index.d.ts",
      "node": "./dist/node/adapters/verification-token/index.js",
      "default": "./dist/worker/adapters/verification-token/index.js"
    },
    "./adapters/magic-link": {
      "types": "./dist/types/adapters/magic-link/index.d.ts",
      "node": "./dist/node/adapters/magic-link/index.js",
      "default": "./dist/worker/adapters/magic-link/index.js"
    },
    "./adapters/webauthn": {
      "types": "./dist/types/adapters/webauthn/index.d.ts",
      "node": "./dist/node/adapters/webauthn/index.js",
      "default": "./dist/worker/adapters/webauthn/index.js"
    },
    "./providers": {
      "types": "./dist/types/providers/index.d.ts",
      "node": "./dist/node/providers/index.js",
      "default": "./dist/worker/providers/index.js"
    },
    "./handlers": {
      "types": "./dist/types/handlers/index.d.ts",
      "node": "./dist/node/handlers/index.js",
      "default": "./dist/worker/handlers/index.js"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "node": "./dist/node/utils/index.js",
      "default": "./dist/worker/utils/index.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "node": "./dist/node/client/index.js",
      "default": "./dist/worker/client/index.js"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "node": "./dist/node/types/index.js",
      "default": "./dist/worker/types/index.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "node": "./dist/node/testing/index.js",
      "default": "./dist/worker/testing/index.js"
    },
    "./mfa": {
      "types": "./dist/types/mfa/index.d.ts",
      "node": "./dist/node/mfa/index.js",
      "default": "./dist/worker/mfa/index.js"
    },
    "./ui": {
      "types": "./dist/types/ui/index.d.ts",
      "node": "./dist/node/ui/index.js",
      "default": "./dist/worker/ui/index.js"
    },
    "./ui/theme.css": "./dist/worker/ui/theme.css",
    "./security": {
      "types": "./dist/types/security/index.d.ts",
      "node": "./dist/node/security/index.js",
      "default": "./dist/worker/security/index.js"
    },
    "./errors": {
      "types": "./dist/types/errors/index.d.ts",
      "node": "./dist/node/errors/index.js",
      "default": "./dist/worker/errors/index.js"
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --testPathPattern=integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsup && node scripts/copy-assets.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run typecheck && npm test && npm run audit",
    "api:scan": "npx @goobits/codeatlas . --format json --out .codeatlas --suggest --entrypoints src/index.ts,src/adapters/index.ts,src/adapters/drizzle/index.ts,src/adapters/database/index.ts,src/adapters/session/index.ts,src/adapters/oauth-token/index.ts,src/adapters/verification-token/index.ts,src/adapters/magic-link/index.ts,src/adapters/webauthn/index.ts,src/providers/index.ts,src/handlers/index.ts,src/utils/index.ts,src/types/index.ts,src/testing/index.ts,src/mfa/index.ts,src/ui/index.ts,src/security/index.ts,src/errors/index.ts",
    "api:map": "npx @goobits/codeatlas . --format mermaid --out .codeatlas --entrypoints src/index.ts,src/adapters/index.ts,src/adapters/drizzle/index.ts,src/adapters/database/index.ts,src/adapters/session/index.ts,src/adapters/oauth-token/index.ts,src/adapters/verification-token/index.ts,src/adapters/magic-link/index.ts,src/adapters/webauthn/index.ts,src/providers/index.ts,src/handlers/index.ts,src/utils/index.ts,src/types/index.ts,src/testing/index.ts,src/mfa/index.ts,src/ui/index.ts,src/security/index.ts,src/errors/index.ts",
    "prepublishOnly": "npm run build && npm run security:check"
  },
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "sveltekit",
    "session",
    "drizzle"
  ],
  "author": "@goobits",
  "license": "MIT",
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "drizzle-orm": "^0.44.0"
  },
  "dependencies": {
    "@oslojs/encoding": "^1.1.0",
    "@simplewebauthn/server": "^13.2.2",
    "arctic": "^3.7.0",
    "hash-wasm": "^4.12.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@node-rs/argon2": "^2.0.2"
  },
  "overrides": {
    "cookie": "^0.7.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.52.0",
    "@types/node": "^22.19.11",
    "pg-mem": "^3.0.13",
    "pg-server": "^0.1.8",
    "postgres": "^3.4.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "vitest": {
    "test": {
      "setupFiles": [
        "./vitest.setup.js"
      ]
    }
  }
}
