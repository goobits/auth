{
	"name": "@goobits/auth",
	"version": "0.2.0",
	"description": "Pluggable authentication system for SvelteKit applications",
	"type": "module",
	"main": "./dist/node/index.js",
	"types": "./dist/types/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goobits/auth.git"
	},
	"homepage": "https://github.com/goobits/auth#readme",
	"bugs": {
		"url": "https://github.com/goobits/auth/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"**/*.css",
		"**/*.svelte"
	],
	"files": [
		"dist",
		"docs",
		"examples",
		"CHANGELOG.md",
		"README.md",
		"LICENSE",
		"SECURITY.md"
	],
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"node": "./dist/node/index.js",
			"default": "./dist/worker/index.js"
		},
		"./adapters/database": {
			"types": "./dist/types/adapters/database/index.d.ts",
			"node": "./dist/node/adapters/database/index.js",
			"default": "./dist/worker/adapters/database/index.js"
		},
		"./adapters/session": {
			"types": "./dist/types/adapters/session/index.d.ts",
			"node": "./dist/node/adapters/session/index.js",
			"default": "./dist/worker/adapters/session/index.js"
		},
		"./adapters/oauth-token": {
			"types": "./dist/types/adapters/oauth-token/index.d.ts",
			"node": "./dist/node/adapters/oauth-token/index.js",
			"default": "./dist/worker/adapters/oauth-token/index.js"
		},
		"./adapters/drizzle": {
			"types": "./dist/types/adapters/drizzle/index.d.ts",
			"node": "./dist/node/adapters/drizzle/index.js",
			"default": "./dist/worker/adapters/drizzle/index.js"
		},
		"./adapters/memory": {
			"types": "./dist/types/adapters/memory/index.d.ts",
			"node": "./dist/node/adapters/memory/index.js",
			"default": "./dist/worker/adapters/memory/index.js"
		},
		"./adapters/pg": {
			"types": "./dist/types/adapters/pg/index.d.ts",
			"node": "./dist/node/adapters/pg/index.js"
		},
		"./adapters/verification-token": {
			"types": "./dist/types/adapters/verification-token/index.d.ts",
			"node": "./dist/node/adapters/verification-token/index.js",
			"default": "./dist/worker/adapters/verification-token/index.js"
		},
		"./adapters/magic-link": {
			"types": "./dist/types/adapters/magic-link/index.d.ts",
			"node": "./dist/node/adapters/magic-link/index.js",
			"default": "./dist/worker/adapters/magic-link/index.js"
		},
		"./adapters/mfa": {
			"types": "./dist/types/adapters/mfa/index.d.ts",
			"node": "./dist/node/adapters/mfa/index.js",
			"default": "./dist/worker/adapters/mfa/index.js"
		},
		"./adapters/webauthn": {
			"types": "./dist/types/adapters/webauthn/index.d.ts",
			"node": "./dist/node/adapters/webauthn/index.js",
			"default": "./dist/worker/adapters/webauthn/index.js"
		},
		"./providers": {
			"types": "./dist/types/providers/index.d.ts",
			"node": "./dist/node/providers/index.js",
			"default": "./dist/worker/providers/index.js"
		},
		"./password": {
			"types": "./dist/types/password/index.d.ts",
			"node": "./dist/node/password/index.js",
			"default": "./dist/worker/password/index.js"
		},
		"./types": {
			"types": "./dist/types/types/index.d.ts",
			"node": "./dist/node/types/index.js",
			"default": "./dist/worker/types/index.js"
		},
		"./mfa": {
			"types": "./dist/types/mfa/index.d.ts",
			"node": "./dist/node/mfa/index.js",
			"default": "./dist/worker/mfa/index.js"
		},
		"./qr": {
			"types": "./dist/types/qr/index.d.ts",
			"node": "./dist/node/qr/index.js",
			"default": "./dist/worker/qr/index.js"
		},
		"./node": {
			"types": "./dist/types/node/index.d.ts",
			"node": "./dist/node/node/index.js"
		},
		"./ui": {
			"types": "./dist/types/ui/index.d.ts",
			"node": "./dist/node/ui/index.js",
			"default": "./dist/worker/ui/index.js"
		},
		"./ui/theme.css": {
			"node": "./dist/node/ui/theme.css",
			"default": "./dist/worker/ui/theme.css"
		},
		"./security": {
			"types": "./dist/types/security/index.d.ts",
			"node": "./dist/node/security/index.js",
			"default": "./dist/worker/security/index.js"
		},
		"./adapters": {
			"types": "./dist/types/adapters/index.d.ts",
			"node": "./dist/node/adapters/index.js",
			"default": "./dist/worker/adapters/index.js"
		},
		"./handlers": {
			"types": "./dist/types/handlers/index.d.ts",
			"node": "./dist/node/handlers/index.js",
			"default": "./dist/worker/handlers/index.js"
		},
		"./login-context": {
			"types": "./dist/types/login-context/index.d.ts",
			"node": "./dist/node/login-context/index.js",
			"default": "./dist/worker/login-context/index.js"
		},
		"./client": {
			"types": "./dist/types/client/index.d.ts",
			"node": "./dist/node/client/index.js",
			"default": "./dist/worker/client/index.js"
		},
		"./testing": {
			"types": "./dist/types/testing/index.d.ts",
			"node": "./dist/node/testing/index.js",
			"default": "./dist/worker/testing/index.js"
		},
		"./errors": {
			"types": "./dist/types/errors/index.d.ts",
			"node": "./dist/node/errors/index.js",
			"default": "./dist/worker/errors/index.js"
		},
		"./utils": {
			"types": "./dist/types/utils/index.d.ts",
			"node": "./dist/node/utils/index.js",
			"default": "./dist/worker/utils/index.js"
		}
	},
	"scripts": {
		"test": "vitest run",
		"test:dist": "node scripts/smokeDist.mjs",
		"test:watch": "vitest watch",
		"test:ui": "vitest --ui",
		"test:integration": "vitest run --testPathPattern=integration",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "rm -rf dist && tsup && pnpm run build:types && node scripts/finalizeDist.mjs",
		"build:types": "tsc -p tsconfig.build.json",
		"audit": "node scripts/auditPackage.mjs",
		"security:check": "pnpm run typecheck && pnpm test && pnpm run audit",
		"prepublishOnly": "pnpm run build && pnpm run test:dist && pnpm run security:check"
	},
	"keywords": [
		"auth",
		"authentication",
		"oauth",
		"sveltekit",
		"session",
		"drizzle"
	],
	"author": "@goobits",
	"license": "MIT",
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"drizzle-orm": "^0.45.2",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		}
	},
	"dependencies": {
		"@goobits/security": "workspace:*",
		"@oslojs/encoding": "^1.1.0",
		"@simplewebauthn/server": "^13.3.2",
		"arctic": "^3.7.0",
		"hash-wasm": "^4.12.0",
		"uqr": "^0.1.3",
		"zod": "^4.4.3"
	},
	"optionalDependencies": {
		"@node-rs/argon2": "^2.0.2"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.69.1",
		"@types/node": "^26.1.0",
		"pg-mem": "^3.0.14",
		"postgres": "^3.4.9",
		"svelte": "^5.56.4",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"overrides": {
		"cookie": "^0.7.0"
	},
	"packageManager": "pnpm@11.10.0"
}
