	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:dist": "node scripts/smokeDist.mjs",
		"test:watch": "vitest watch",
		"test:ui": "vitest --ui",
		"test:integration": "vitest run __tests__/integration",
		"test:postgres": "node -e \"if (!process.env.DATABASE_URL) { console.error('DATABASE_URL is required'); process.exit(1) }\" && vitest run __tests__/integration --maxWorkers=1",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"check:dist-fresh": "node scripts/checkDistFresh.mjs",
		"ensure:dist": "node scripts/ensureDistFresh.mjs",
		"build": "rm -rf dist && tsup && pnpm run build:types && node scripts/finalizeDist.mjs",
		"postbuild": "pnpm run test:dist",
		"build:types": "tsc -p tsconfig.build.json",
		"audit": "node scripts/auditPackage.mjs",
		"security:check": "pnpm run typecheck && pnpm test && pnpm run audit",
		"api:scan": "npx @goobits/codeatlas . --format json --out .codeatlas --suggest --entrypoints src/index.ts,src/adapters/index.ts,src/adapters/database/index.ts,src/adapters/session/index.ts,src/adapters/oauth-token/index.ts,src/adapters/drizzle/index.ts,src/adapters/memory/index.ts,src/adapters/pg/index.ts,src/adapters/verification-token/index.ts,src/adapters/magic-link/index.ts,src/adapters/mfa/index.ts,src/adapters/webauthn/index.ts,src/providers/index.ts,src/handlers/index.ts,src/login-context/index.ts,src/verification/index.ts,src/client/index.ts,src/password/index.ts,src/types/index.ts,src/testing/index.ts,src/mfa/index.ts,src/qr/index.ts,src/node/index.ts,src/ui/index.ts,src/security/index.ts,src/errors/index.ts",
		"api:map": "npx @goobits/codeatlas . --format mermaid --out .codeatlas --entrypoints src/index.ts,src/adapters/index.ts,src/adapters/database/index.ts,src/adapters/session/index.ts,src/adapters/oauth-token/index.ts,src/adapters/drizzle/index.ts,src/adapters/memory/index.ts,src/adapters/pg/index.ts,src/adapters/verification-token/index.ts,src/adapters/magic-link/index.ts,src/adapters/mfa/index.ts,src/adapters/webauthn/index.ts,src/providers/index.ts,src/handlers/index.ts,src/login-context/index.ts,src/verification/index.ts,src/client/index.ts,src/password/index.ts,src/types/index.ts,src/testing/index.ts,src/mfa/index.ts,src/qr/index.ts,src/node/index.ts,src/ui/index.ts,src/security/index.ts,src/errors/index.ts",
		"prepublishOnly": "pnpm run build && pnpm run security:check"
	},
