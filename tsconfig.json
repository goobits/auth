{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "functions/**/*.ts",
    "packages/**/*.ts",
    "serverless/**/*.ts",
    "vite.config.js",
    "svelte.config.js"
  ],
  "exclude": ["node_modules", "static", "software"]
}
