{
	"root": ".",
	"postgres": {
		"contracts": [
			{
				"id": "auth-postgres",
				"bootstrap_sources": [
					{
						"path": "src/adapters/pg/schema.ts",
						"transaction": "always",
						"psql_meta_commands": "reject"
					}
				],
				"query_roots": ["src/adapters/pg"],
				"source_complete": true
			}
		]
	},
	"projects": [
		{
			"id": "auth",
			"root": ".",
			"contexts": {
				"example-app": {
					"role": "tooling",
					"scope": "runtime",
					"entrypoints": ["examples/sveltekit-quickstart/src/lib/auth.ts"]
				},
				"node-runtime": {
					"role": "production",
					"scope": "public_surface",
					"entrypoints": ["src/password/index.node.ts"]
				}
			}
		}
	]
}
