contact-form {
	display: block

	contact-form-errors {
		color: var(--form-error)
		display: block
		padding: 0.5em 0 0.75em 0.5em
		list-style-type: square
	}

	form-title {
		padding-left: 0.5em

		span {
			color: var(--form-error)
			float: right
			font-weight: bold
		}
	}

	textarea {
		height: 10em
		margin-bottom: 0
	}

	.legal-note {
		margin: 1em 0 0
		font-size: 0.9rem
		line-height: 1.5
		opacity: 0.85
	}

	.legal-note a {
		margin: 0 0.2em
	}
}
